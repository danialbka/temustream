*.p8
*.pfx
*.cer
*.crt
*.csr
*.der
*.key
*.pem
*.jks
*.keystore
*.kdbx
*.log
*.xcarchive
*.dSYM
*.dSYM.zip
*.bcsymbolmap
*.itmsp
xcuserdata/
DerivedData/
target/

# Generated test, coverage, profiling, and local IDE output. Test source stays tracked.
*.xcresult
*.resultbundle
*.profraw
*.profdata
*.gcda
*.gcno
*.trace
.coverage
.nyc_output/
.pytest_cache/
coverage/
test-results/
TestResults/
UITestResults/
.idea/
.vscode/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
.xcode.env.local

# Machine-local player deployment state and accidental Xcode duplicates.
minimal-app/config/*.snapshot.json
minimal-app/config/Signing.local.xcconfig
minimal-app/config/ExportOptions.local.plist
minimal-app/StremioSkeleton [0-9]*.xcodeproj/
minimal-app/iOS/Resources/Info [0-9]*.plist
minimal-app/iOS/Resources/StremioSkeleton [0-9]*.entitlements
README [0-9]*.md
SECURITY [0-9]*.md

# Local enhancer build products.
enhancer/build/
