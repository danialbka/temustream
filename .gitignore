.DS_Store
.env
.env.*
!.env.example

# Official IPA artifacts are downloaded locally and must not be committed.
artifacts/*
!artifacts/.gitkeep
*.ipa
*.app
*.dylib
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.der
*.key
*.pem
*.log
*.xcarchive
xcuserdata/
DerivedData/
target/

# Machine-local player deployment state and accidental Xcode duplicates.
minimal-app/config/*.snapshot.json
minimal-app/StremioSkeleton [3-9]*.xcodeproj/
minimal-app/iOS/Resources/StremioSkeleton [0-9]*.entitlements

# Local enhancer build products.
enhancer/build/
